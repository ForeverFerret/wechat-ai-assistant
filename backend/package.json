{
  "name": "wechat-ai-assistant-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for WeChat AI Assistant",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init:local": "wrangler d1 execute wechat_ai_db --local --file=../schema.sql",
    "d1:init:remote": "wrangler d1 execute wechat_ai_db --remote --file=../schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
